# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TrustMetrics

# Database Configuration
# Prisma connection string - Get this from your Supabase project settings under Database
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxxx.supabase.co:5432/postgres

# Supabase Configuration
# Get these from your Supabase project settings under API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Whop OAuth Configuration
# Get these from your Whop Developer Dashboard at https://whop.com/apps
WHOP_CLIENT_ID=your-whop-client-id-here
WHOP_CLIENT_SECRET=your-whop-client-secret-here
WHOP_REDIRECT_URI=http://localhost:3000/api/auth/whop/callback

# Authentication (if needed)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# API Configuration
NEXT_PUBLIC_API_URL=https://api.example.com
API_SECRET_KEY=your-secret-key-here

# Cron Job Configuration
# Secret key for authenticating cron job requests
# Generate a secure random string (e.g., openssl rand -base64 32)
CRON_SECRET=your-secure-cron-secret-here

# Stripe Configuration
# Get these from your Stripe Dashboard at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# Stripe Webhook Secret
# Get this from Stripe Dashboard > Webhooks after creating a webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Stripe Price IDs (create these in Stripe Dashboard > Products)
STRIPE_BRONZE_PRICE_ID=price_your-bronze-price-id-here
STRIPE_SILVER_PRICE_ID=price_your-silver-price-id-here
STRIPE_GOLD_PRICE_ID=price_your-gold-price-id-here
